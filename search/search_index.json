{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"]},"docs":[{"location":"","title":"Home Page","text":"<p>\u263a\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e3b\u9875</p>"},{"location":"about/","title":"About Me","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/","title":"\u6570\u636e\u5c42\u9762","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/#_2","title":"\u6570\u636e\u96c6\u89c4\u6a21","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/#_3","title":"\u6570\u636e\u591a\u6837\u6027","text":"<p>\u6570\u636e\u5e94\u8be5\u8986\u76d6\u4efb\u52a1\u7684\u6240\u6709\u53ef\u80fd\u7684\u573a\u666f\u3002\u4f8b\u5982\uff0c\u81ea\u52a8\u9a7e\u9a76\u6570\u636e\u9700\u8981\u6536\u96c6\u5404\u79cd\u5929\u6c14\u3001\u5404\u79cd\u5149\u7ebf\u6761\u4ef6\u4e0b\u7684\u6837\u672c</p> <p>\u89e3\u51b3\u65b9\u6cd5 1. \u6536\u96c6\u591a\u6837\u5316\u6570\u636e 2. \u901a\u8fc7\u6570\u636e\u589e\u5f3a\uff08\u5982\u62fc\u63a5\u3001\u989c\u8272\u6296\u52a8\uff09\u6a21\u62df\u4e0d\u540c\u573a\u666f</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_4","title":"\u6570\u636e\u89c4\u6a21","text":"<p>\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u901a\u5e38\u9700\u8981\u5927\u91cf\u7684\u6570\u636e\u6765\u6355\u6349\u590d\u6742\u7684\u6a21\u5f0f\u3002\u5982\u679c\u6570\u636e\u91cf\u592a\u5c11\uff0c\u6a21\u578b\u5bb9\u6613\u8fc7\u62df\u5408\uff0c\u5bfc\u81f4\u5728\u8bad\u7ec3\u96c6\u4e0a\u8868\u73b0\u826f\u597d\uff0c\u4f46\u5728\u6d4b\u8bd5\u96c6\u4e0a\u6cdb\u5316\u80fd\u529b\u5dee</p> <p>\u89e3\u51b3\u65b9\u6cd5 1. \u6536\u96c6\u66f4\u591a\u6570\u636e 2. \u901a\u8fc7\u6570\u636e\u589e\u5f3a\uff08\u65cb\u8f6c\u3001\u7ffb\u8f6c\u3001\u5e73\u79fb\u3001\u7f29\u653e\u7b49\uff09\u589e\u5927\u6570\u636e\u89c4\u6a21 3. \u4f7f\u7528\u8fc1\u79fb\u5b66\u4e60 4. \u751f\u6210\u5408\u6210\u6570\u636e\uff08\u901a\u8fc7\u8ba1\u7b97\u673a\u7b97\u6cd5\u548c\u6a21\u578b\u751f\u6210\u4e0e\u771f\u5b9e\u6570\u636e\u5177\u6709\u76f8\u4f3c\u7279\u5f81\u548c\u7edf\u8ba1\u5206\u5e03\u7684\u4eba\u5de5\u6570\u636e\uff09</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_5","title":"\u7c7b\u522b\u4e0d\u5e73\u8861","text":"<p>\u7c7b\u522b\u4e0d\u5e73\u8861\u662f\u6307\u67d0\u4e9b\u7c7b\u522b\u7684\u6837\u672c\u6570\u91cf\u8fdc\u5c11\u4e8e\u5176\u4ed6\u7c7b\u522b\u3002\u5728\u6df1\u5ea6\u5b66\u4e60\u4e2d\uff0c\u6570\u636e\u96c6\u4e0d\u5e73\u8861\u4f1a\u5bf9\u6a21\u578b\u7684\u8bad\u7ec3\u548c\u6027\u80fd\u4ea7\u751f\u591a\u65b9\u9762\u7684\u5f71\u54cd\uff1a + \u6a21\u578b\u504f\u5411\u591a\u6570\u7c7b\uff1a\u5f53\u67d0\u4e00\u7c7b\u522b\u7684\u6837\u672c\u6570\u91cf\u8fdc\u591a\u4e8e\u5176\u4ed6\u7c7b\u522b\u65f6\uff0c\u6a21\u578b\u503e\u5411\u4e8e\u5b66\u4e60\u591a\u6570\u7c7b\u7684\u7279\u5f81\uff0c\u800c\u5ffd\u7565\u5c11\u6570\u7c7b\u7684\u7279\u5f81\uff08\u8fd9\u662f\u56e0\u4e3a\u6a21\u578b\u7684\u635f\u5931\u51fd\u6570\u901a\u5e38\u662f\u5bf9\u6240\u6709\u6837\u672c\u7684\u5e73\u5747\u8d21\u732e\uff0c\u591a\u6570\u7c7b\u5bf9\u635f\u5931\u7684\u5360\u6bd4\u66f4\u5927\uff09\uff0c\u4ece\u800c\u5bfc\u81f4\u6a21\u578b\u5728\u591a\u6570\u7c7b\u4e0a\u8868\u73b0\u826f\u597d\uff0c\u4f46\u5728\u5c11\u6570\u7c7b\u4e0a\u7684\u8bc4\u4ef7\u6307\u6807\u663e\u8457\u4e0b\u964d + \u8bc4\u4ef7\u6307\u6807\u5931\u771f\uff1a\u7c7b\u522b\u4e0d\u5e73\u8861\u65f6\u4e00\u4e9b\u8bc4\u4ef7\u6307\u6807\uff08\u5982\u51c6\u786e\u7387\uff09\u4f1a\u5931\u53bb\u610f\u4e49\u3002\u4f8b\u5982\u4e00\u4e2a\u6570\u636e\u96c6\u670995%\u7684\u591a\u6570\u7c7b\u548c5%\u7684\u5c11\u6570\u7c7b\uff0c\u5373\u4f7f\u6a21\u578b\u603b\u662f\u9884\u6d4b\u591a\u6570\u7c7b\uff0c\u51c6\u786e\u7387\u4e5f\u80fd\u8fbe\u523095%\uff0c\u4f46\u8fd9\u5bf9\u5c11\u6570\u7c7b\u7684\u9884\u6d4b\u6beb\u65e0\u7528\u5904\uff0c\u56e0\u6b64\u9700\u8981\u4f7f\u7528\u66f4\u5408\u9002\u7684\u6307\u6807\uff08\u5982\u7cbe\u5ea6\u3001\u53ec\u56de\u7387\u3001F1 Score\u6216ROC-AUC\uff09 + \u6cdb\u5316\u80fd\u529b\u4e0b\u964d\uff1a\u6a21\u578b\u53ef\u80fd\u8fc7\u62df\u5408\u591a\u6570\u7c7b\uff0c\u5728\u5c11\u6570\u7c7b\u4e0a\u6b20\u62df\u5408\uff0c\u6cdb\u5316\u80fd\u529b\u5dee + \u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u7684\u68af\u5ea6\u95ee\u9898\uff1a\u591a\u6570\u7c7b\u7684\u6837\u672c\u4e3b\u5bfc\u4e86\u68af\u5ea6\u66f4\u65b0\u65b9\u5411\uff0c\u53ef\u80fd\u4f7f\u6a21\u578b\u7684\u4f18\u5316\u8fc7\u7a0b\u504f\u5411\u4e8e\u4f18\u5316\u591a\u6570\u7c7b\u7684\u635f\u5931\uff0c\u5ffd\u89c6\u5c11\u6570\u7c7b\u7684\u8d21\u732e\uff0c\u4ece\u800c\u5bfc\u81f4\u6a21\u578b\u7684\u53c2\u6570\u66f4\u65b0\u96be\u4ee5\u6355\u6349\u5c11\u6570\u7c7b\u7684\u7279\u5f81\uff0c\u5b66\u4e60\u8fc7\u7a0b\u53d8\u5f97\u4f4e\u6548</p> <p>\u89e3\u51b3\u65b9\u6cd5 \u6570\u636e\u5c42\u9762 1. \u8fc7\u91c7\u6837\u5c11\u6570\u7c7b\uff1a\u8fc7\u91c7\u6837\u7684\u76ee\u6807\u662f\u589e\u52a0\u5c11\u6570\u7c7b\u6837\u672c\u7684\u6570\u91cf\uff0c\u4f7f\u5c11\u6570\u7c7b\u548c\u591a\u6570\u7c7b\u7684\u6837\u672c\u6570\u91cf\u8fbe\u5230\u5e73\u8861\uff1a    + \u968f\u673a\u8fc7\u91c7\u6837\uff1a\u968f\u673a\u590d\u5236\u5c11\u6570\u7c7b\u6837\u672c\u6765\u589e\u52a0\u5c11\u6570\u7c7b\u6570\u91cf    + SMOTE\uff08\u5408\u6210\u5c11\u6570\u7c7b\u8fc7\u91c7\u6837\u6280\u672f\uff09\uff0c\u901a\u8fc7\u751f\u6210\u5408\u6210\u6837\u672c\u589e\u52a0\u5c11\u6570\u7c7b\u6570\u636e 2. \u6b20\u91c7\u6837\u591a\u6570\u7c7b\uff1a    + \u968f\u673a\u6b20\u91c7\u6837\uff1a\u968f\u673a\u5220\u9664\u591a\u6570\u7c7b\u6837\u672c\uff0c\u76f4\u5230\u7c7b\u522b\u5e73\u8861\uff0c\u4f46\u53ef\u80fd\u4e22\u5931\u5173\u952e\u4fe1\u606f 3. \u52a0\u6743\u91c7\u6837\uff1a\u901a\u8fc7\u4e3a\u6837\u672c\u5b9a\u4e49\u6743\u91cd\uff0c\u6839\u636e\u6837\u672c\u6743\u91cd\u8fdb\u884c\u91c7\u6837 4. \u6570\u636e\u589e\u5f3a\uff1a\u5bf9\u5c11\u6570\u7c7b\u6837\u672c\u5e94\u7528\u6570\u636e\u589e\u5f3a\u4ee5\u589e\u52a0\u591a\u6837\u6027</p> <p>\u635f\u5931\u51fd\u6570\u5c42\u9762 1. \u52a0\u6743\u635f\u5931\uff1a\u5bf9\u5c11\u6570\u7c7b\u5206\u914d\u66f4\u9ad8\u7684\u635f\u5931\u6743\u91cd\uff0c\u4f7f\u6a21\u578b\u66f4\u5173\u6ce8\u8fd9\u4e9b\u6837\u672c 2. Focal Loss\uff1a\u964d\u4f4e\u5bf9\u6613\u5206\u7c7b\u6837\u672c\u7684\u5173\u6ce8\uff0c\u805a\u7126\u4e8e\u96be\u5206\u7c7b\u6837\u672c</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_6","title":"\u6570\u636e\u5206\u5e03","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/#_7","title":"\u6570\u636e\u96c6\u504f\u79fb","text":"<p>\u6570\u636e\u96c6\u504f\u79fb\u662f\u6307\uff1a\u8bad\u7ec3\u6570\u636e\u548c\u6d4b\u8bd5\u6570\u636e\uff08\u6216\u5b9e\u9645\u4f7f\u7528\u573a\u666f\uff09\u7684\u6570\u636e\u73af\u5883\u4e0d\u540c\uff0c\u4ece\u800c\u5bfc\u81f4\u6a21\u578b\u6027\u80fd\u4e0b\u964d\u3002\u4f8b\u5982\u4e00\u4e2a\u732b\u72d7\u5206\u7c7b\u6a21\u578b\uff0c\u8bad\u7ec3\u6570\u636e\u662f\u767d\u5929\u62cd\u6444\u7684\u56fe\u50cf\uff0c\u800c\u4f7f\u7528\u573a\u666f\u662f\u508d\u665a</p> <p>\u89e3\u51b3\u65b9\u6cd5 1. \u786e\u4fdd\u8bad\u7ec3\u3001\u9a8c\u8bc1\u548c\u6d4b\u8bd5\u6570\u636e\u7684\u5206\u5e03\u4e00\u81f4\uff08\u5982\u5206\u5c42\u62bd\u6837\uff09 2. \u6570\u636e\u5f52\u4e00\u5316\uff0c\u51cf\u5c11\u6570\u636e\u5206\u5e03\u4e4b\u95f4\u7684\u5dee\u5f02</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_8","title":"\u6570\u636e\u504f\u501a","text":"<p>\u6570\u636e\u504f\u79fb\u7684\u6838\u5fc3\u662f\uff1a\u8bad\u7ec3\u6570\u636e\u7684\u4ee3\u8868\u6027\u4e0d\u8db3\uff0c\u65e0\u6cd5\u5f88\u597d\u5730\u4ee3\u8868\u6574\u4e2a\u76ee\u6807\u5206\u5e03</p> <p>\u89e3\u51b3\u65b9\u6cd5 1. \u589e\u52a0\u4ee3\u8868\u6027\u4e0d\u8db3\u7684\u6837\u672c 2. \u6570\u636e\u589e\u5f3a</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_9","title":"\u6570\u636e\u8d28\u91cf","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/#_10","title":"\u6570\u636e\u672c\u8eab","text":"<p>\u6570\u636e\u7684\u8d28\u91cf\u53ef\u4ee5\u4ece\u4ee5\u4e0b\u51e0\u4e2a\u89d2\u5ea6\u8fdb\u884c\u8bc4\u4f30\uff1a</p> <p>\u5b8c\u6574\u6027 \u6570\u636e\u96c6\u4e2d\u7684\u6bcf\u4e2a\u6837\u672c\u662f\u5426\u5305\u542b\u4e86\u6240\u6709\u5fc5\u8981\u7684\u4fe1\u606f\uff0c\u662f\u5426\u7f3a\u5931\u5173\u952e\u7684\u90e8\u5206</p> <p>\u51c6\u786e\u6027 \u6570\u636e\u4e2d\u7684\u4fe1\u606f\u662f\u5426\u51c6\u786e\u65e0\u8bef</p> <p>\u4e00\u81f4\u6027 \u6570\u636e\u7684\u683c\u5f0f\u3001\u5355\u4f4d\u3001\u547d\u540d\u89c4\u5219\u7b49\u662f\u5426\u4e00\u81f4\u3002\u4f8b\u5982\uff0c\u56fe\u50cf\u6570\u636e\u96c6\u7684\u5206\u8fa8\u7387\u6216\u989c\u8272\u901a\u9053\u662f\u5426\u7edf\u4e00</p> <p>\u4ee3\u8868\u6027 \u6570\u636e\u96c6\u662f\u5426\u80fd\u591f\u4ee3\u8868\u6574\u4e2a\u76ee\u6807\u9886\u57df\u6216\u7fa4\u4f53\uff0c\u662f\u5426\u5177\u6709\u660e\u663e\u7684\u6837\u672c\u504f\u501a\u6216\u6570\u636e\u96c6\u504f\u79fb</p> <p>\u566a\u58f0</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_11","title":"\u6807\u6ce8\u8d28\u91cf","text":"<p>\u4eba\u5de5\u6807\u6ce8\u53ef\u80fd\u56e0\u6807\u6ce8\u8005\u7684\u4e3b\u89c2\u5224\u65ad\u800c\u4ea7\u751f\u504f\u5dee\u3002\u4f8b\u5982\uff0c\u60c5\u611f\u5206\u6790\u4e2d\u201c\u79ef\u6781\u201d\u548c\u201c\u6d88\u6781\u201d\u7684\u754c\u9650\u53ef\u80fd\u6a21\u7cca\uff0c\u5bfc\u81f4\u6a21\u578b\u5b66\u5230\u7684\u6a21\u5f0f\u4e0d\u51c6\u786e\uff0c\u751a\u81f3\u77db\u76fe</p> <p>\u89e3\u51b3\u65b9\u6cd5 \u591a\u4f4d\u6807\u6ce8\u8005\u4ea4\u53c9\u9a8c\u8bc1\u3001\u4f7f\u7528\u660e\u786e\u7684\u6807\u6ce8\u6307\u5357\u3001\u5f15\u5165\u81ea\u52a8\u5316\u6807\u6ce8\u5de5\u5177\u5e76\u4eba\u5de5\u590d\u6838</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_12","title":"\u6570\u636e\u9884\u5904\u7406\u4e0e\u683c\u5f0f","text":"<ul> <li>\u5f52\u4e00\u5316/\u6807\u51c6\u5316\uff1a\u4e0d\u540c\u7279\u5f81\u7684\u6570\u503c\u8303\u56f4\u53ef\u80fd\u5dee\u5f02\u5f88\u5927\uff08\u5982\u50cf\u7d20\u503c 0-255\uff0c\u6e29\u5ea6\u503c 0-100\uff09\uff0c\u672a\u7ecf\u5904\u7406\u4f1a\u5f71\u54cd\u68af\u5ea6\u4e0b\u964d</li> </ul> <p>\u89e3\u51b3\u65b9\u6cd5 \u5bf9\u6570\u503c\u7279\u5f81\u8fdb\u884c\u5f52\u4e00\u5316\uff08\u5982 [0,1]\uff09\u6216\u6807\u51c6\u5316\uff08\u5982\u5747\u503c\u4e3a 0\uff0c\u65b9\u5dee\u4e3a 1\uff09</p>"},{"location":"Dive2AI/0%20Methodology/Methodology/#_13","title":"\u6a21\u578b","text":""},{"location":"Dive2AI/0%20Methodology/Methodology/#_14","title":"\u4f18\u5316","text":""},{"location":"Dive2AI/4%20Optimization/Regularization/","title":"Regularization","text":"<p>\u8fc7\u62df\u5408\u901a\u5e38\u662f\u56e0\u4e3a\u6a21\u578b\u7684\u590d\u6742\u5ea6\u592a\u9ad8\uff0c\u53ef\u4ee5\u901a\u8fc7\u964d\u4f4e\u6a21\u578b\u7684\u6df1\u5ea6\u548c\u5bbd\u5ea6\u3001\u6b63\u5219\u5316\u7b49\u624b\u6bb5\u964d\u4f4e\u8fc7\u62df\u5408\u7684\u7a0b\u5ea6</p> <p>\u5373\u4f7f\u964d\u4f4e\u4e86\u6a21\u578b\u7684\u590d\u6742\u5ea6\uff0c\u6570\u636e\u4e5f\u6709\u5bfc\u81f4\u8fc7\u62df\u5408\u7684\u9690\u60a3\uff0c\u5177\u4f53\u6765\u8bf4\uff1a + \u6570\u636e\u91cf\u4e0d\u8db3\u3002\u5982\u679c\u8bad\u7ec3\u6570\u636e\u592a\u5c11\uff0c\u6a21\u578b\u53ef\u80fd\u65e0\u6cd5\u6cdb\u5316\uff0c\u5373\u4f7f\u6a21\u578b\u7b80\u5355\u4e5f\u4f1a\u8bb0\u4f4f\u6570\u636e\u4e2d\u7684\u566a\u58f0\uff0c\u5bfc\u81f4\u8fc7\u62df\u5408\u3002\u6b64\u65f6\u9700\u8981\u6536\u96c6\u66f4\u591a\u7684\u6570\u636e\u6216\u8005\u6570\u636e\u589e\u5f3a + \u6570\u636e\u566a\u58f0\u592a\u591a\u3002\u5982\u679c\u6570\u636e\u4e2d\u5b58\u5728\u5927\u91cf\u566a\u58f0\u6216\u9519\u8bef\u6807\u7b7e\uff0c\u7b80\u5355\u7684\u6a21\u578b\u53ef\u80fd\u4f1a\u88ab\u8fd9\u4e9b\u566a\u58f0\u5e72\u6270\uff0c\u5bfc\u81f4\u5728\u8bad\u7ec3\u96c6\u4e0a\u8868\u73b0\u597d\u4f46\u6cdb\u5316\u5dee\u3002\u6b64\u65f6\u9700\u8981\u6570\u636e\u6e05\u6d17\u6216\u53bb\u566a\u5904\u7406</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/","title":"Metrics","text":"<p>Author\uff1a@\u674e\u884d\u535a</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#_1","title":"\u7b26\u53f7\u89c4\u5b9a","text":"<p>TP\uff1a\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\uff08\u771f\u5b9e\u6807\u7b7e\u662f\u6b63\u7c7b\uff0c\u6a21\u578b\u4e5f\u9884\u6d4b\u4e3a\u6b63\u7c7b\uff09 FP\uff1a\u6a21\u578b\u9519\u8bef\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\uff08\u771f\u5b9e\u6807\u7b7e\u662f\u8d1f\u7c7b\uff0c\u4f46\u6a21\u578b\u9884\u6d4b\u4e3a\u6b63\u7c7b\uff09\u3010\u8bef\u8bca\u3011 FN\uff1a\u6a21\u578b\u9519\u8bef\u9884\u6d4b\u4e3a\u8d1f\u7c7b\u7684\u6837\u672c\uff08\u771f\u5b9e\u6807\u7b7e\u4e3a\u6b63\u7c7b\uff0c\u4f46\u6a21\u578b\u9884\u6d4b\u4e3a\u8d1f\u7c7b\uff09\u3010\u6f0f\u8bca\u3011 TN\uff1a\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u4e3a\u8d1f\u7c7b\u7684\u6837\u672c\uff08\u771f\u5b9e\u6807\u7b7e\u662f\u8d1f\u7c7b\uff0c\u6a21\u578b\u4e5f\u9884\u6d4b\u4e3a\u8d1f\u7c7b\uff09</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#classification","title":"Classification","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#binary-classification","title":"Binary Classification","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#accuracy","title":"Accuracy","text":"<p>\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u7c7b\u522b\u7684\u6837\u672c\u5360\u603b\u6837\u672c\u6570\u7684\u6bd4\u4f8b $$ Accuracy = \\frac{TP + TN}{TP + TN + FP + FN} $$</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#precision","title":"Precision","text":"<p>\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u5360\u6a21\u578b\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u7684\u6bd4\u4f8b $$ Precision = \\frac{TP}{TP + FP} $$</p> <p>E.g. \u7cbe\u5ea6\u53ef\u4ee5\u7c7b\u6bd4\u6210\u8003\u8bd5\u4e2d\u4f60\u505a\u4e86\u7684\u6240\u6709\u9898\u76ee\u4e2d\uff0c\u505a\u5bf9\u7684\u9898\u76ee\u6240\u5360\u7684\u6bd4\u4f8b\u3002TP\u662f\u505a\u4e86\u4e14\u505a\u5bf9\u4e86\u7684\u9898\u76ee\uff0cTP + FP\u662f\u6240\u6709\u505a\u4e86\u7684\u9898\u76ee</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#recall-sensitivity","title":"Recall / Sensitivity","text":"<p>\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u5360\u771f\u5b9e\u6807\u7b7e\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u7684\u6bd4\u4f8b $$ Recall = \\frac{TP}{TP + FN} $$</p> <p>E.g. \u53ec\u56de\u7387\u53ef\u4ee5\u7c7b\u6bd4\u6210\u8003\u8bd5\u4e2d\u4f60\u9700\u8981\u505a\u5bf9\u7684\u9898\u76ee\u4e2d\uff08\u4f8b\u5982\u76ee\u7684\u662f\u6ee1\u5206\uff09\uff0c\u4f60\u5b9e\u9645\u505a\u5bf9\u4e86\u7684\u9898\u76ee\u6240\u5360\u7684\u6bd4\u4f8b</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#precisionrecall","title":"Precision\u548cRecall\u7684\u8054\u7cfb","text":"<p>Precision\u548cRecall\u662f\u4e0eTP\u3001FP\u3001FN\u76f8\u5173\u7684\u53d8\u91cf\uff0c\u4e0d\u96be\u770b\u51faPrecision\u548cRecall\u662f\u7279\u522b\u5173\u6ce8\u4e8e\u6b63\u7c7b\u7684\u8bc4\u4ef7\u6307\u6807\uff08\u65e0\u8bba\u662f\u771f\u5b9e\u6807\u7b7e\u4e3a\u6b63\u7c7b\u8fd8\u662f\u6a21\u578b\u9884\u6d4b\u4e3a\u6b63\u7c7b\uff09</p> <p><code>Precision</code>\u4ee3\u8868\u4e86\u6a21\u578b\u5bf9\u6b63\u7c7b\u7684<code>\u201c\u67e5\u51c6\u7387\u201d</code> <code>Recall</code>\u4ee3\u8868\u4e86\u6a21\u578b\u5bf9\u6b63\u7c7b\u7684<code>\u201c\u67e5\u5168\u7387\u201d</code></p> <p>\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u901a\u5e38\u65e0\u6cd5\u540c\u65f6\u8fbe\u5230\u6700\u4f18\uff0c\u5b58\u5728\u4e00\u79cd\u6b64\u6d88\u5f7c\u957f\u7684\u5173\u7cfb\uff0c\u56e0\u6b64\u9700\u8981\u5bf9\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u8fdb\u884c\u6743\u8861\uff08Trade-off\uff09\uff1a + \u63d0\u9ad8\u7cbe\u5ea6\uff1a\u6a21\u578b\u53ef\u80fd\u4f1a\u53d8\u5f97\u66f4\u201d\u6311\u5254\u201c\uff0c\u53ea\u5728\u975e\u5e38\u786e\u5b9a\u65f6\u624d\u4f1a\u5c06\u6837\u672c\u9884\u6d4b\u6b63\u7c7b\uff0c\u5bfc\u81f4FP\u51cf\u5c11\u3002\u4f46\u540c\u65f6\uff0c\u53ef\u80fd\u4f1a\u5bfc\u81f4\u6f0f\u6389\u4e00\u4e9b\u6b63\u7c7b\uff0c\u5bfc\u81f4FN\u589e\u52a0\uff0c\u4ece\u800c\u964d\u4f4e\u53ec\u56de\u7387 + \u63d0\u9ad8\u53ec\u56de\u7387\uff1a\u6a21\u578b\u53ef\u80fd\u4f1a\u53d8\u5f97\u66f4\u201d\u5bbd\u677e\u201c\uff0c\u5c3d\u91cf\u627e\u51fa\u6240\u6709\u6b63\u7c7b\uff0c\u5bfc\u81f4FN\u51cf\u5c11\uff1b\u4f46\u540c\u65f6\uff0c\u53ef\u80fd\u4f1a\u8bef\u5224\u4e00\u4e9b\u8d1f\u7c7b\u4e3a\u6b63\u7c7b\uff0c\u5bfc\u81f4FP\u589e\u591a\uff0c\u4ece\u800c\u964d\u4f4e\u7cbe\u5ea6 +</p> <p>\u4e3a\u4ec0\u4e48\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u662f\u4e00\u79cd\u6b64\u6d88\u5f7c\u957f\u7684\u5173\u7cfb\uff1f</p> <p>\u5206\u7c7b\u6a21\u578b\u7684\u9884\u6d4b\u7ed3\u679c\u901a\u5e38\u662f\u4e00\u79cd\u5f97\u5206\uff08\u4f8b\u5982\u6982\u7387\u6216logits\uff09\uff0c\u901a\u8fc7\u4e0e\u4e00\u4e2a\u9608\u503c\uff08threshold\uff09\u6bd4\u8f83\u6765\u51b3\u5b9a\u6700\u7ec8\u9884\u6d4b\u7c7b\u522b\u3002\u5bf9\u4e00\u4e2a\u6a21\u578b\u7684\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u7684\u8c03\u6574\u53ef\u4ee5\u901a\u8fc7\u6539\u53d8\u9608\u503c\u6765\u5b9e\u73b0\uff08\u6216\u6539\u53d8\u5176\u4ed6\u51b3\u5b9a\u6700\u7ec8\u9884\u6d4b\u7c7b\u522b\u7684\u7b56\u7565\uff09\u3002\u5f53\u63d0\u9ad8\u9608\u503c\u65f6\uff0c\u6a21\u578b\u53d8\u5f97\u66f4\u201d\u4e25\u683c\u201c\uff0c\u53ea\u5728\u5f97\u5206\u9ad8\u65f6\u624d\u9884\u6d4b\u4e3a\u6b63\u7c7b\uff0c\u4ece\u800c\u7cbe\u5ea6\u63d0\u9ad8\uff0c\u4f46\u4e5f\u53ef\u80fd\u56e0\u6b64\u6f0f\u6389\u4e00\u4e9b\u6b63\u7c7b\u5bfc\u81f4\u53ec\u56de\u7387\u964d\u4f4e\u3002\u53ec\u56de\u7387\u540c\u7406</p> <p>\u5bf9\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u901a\u5e38\u6b64\u6d88\u5f7c\u957f\u7684\u66f4\u4e00\u822c\u7684\u89e3\u91ca\u89c6\u89d2\u662f\uff1a\u5f97\u5206\u5206\u5e03\u3002\u6a21\u578b\u5bf9\u6240\u6709\u771f\u5b9e\u6807\u7b7e\u4e3a\u6b63\u7c7b\u548c\u8d1f\u7c7b\u7684\u5f97\u5206\u8f93\u51fa\u4f1a\u5206\u522b\u5f62\u6210\u6b63\u7c7b\u5f97\u5206\u5206\u5e03\u548c\u8d1f\u7c7b\u5f97\u5206\u5206\u5e03\uff08\u6982\u7387\u5bc6\u5ea6\u5206\u5e03\uff09\u3002\u5f53\u8fd9\u4e24\u6761\u5206\u5e03\u66f2\u7ebf\u6709\u91cd\u53e0\u90e8\u5206\u65f6\uff0c\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u5c31\u5b58\u5728\u6b64\u6d88\u5f7c\u957f\u7684\u5173\u7cfb\u3002\u53ef\u4ee5\u5c06\u9608\u503c\u7406\u89e3\u4e3a\u4e00\u6761\u5782\u76f4\u7684\u5206\u754c\u7ebf\uff0c\u5f53\u9608\u503c\u589e\u5927\u65f6\uff08\u5411\u53f3\u79fb\uff09\uff0c\u6709\u4e00\u90e8\u5206\u6b63\u7c7b\u4f1a\u8fdb\u5165\u5206\u754c\u7ebf\u5de6\u8fb9\uff0c\u540c\u65f6\u4f1a\u6709\u66f4\u5c11\u7684\u8d1f\u7c7b\u8fdb\u5165\u5206\u754c\u7ebf\u53f3\u8fb9\uff0c\u4ece\u800c\u5bfc\u81f4\u7cbe\u5ea6\u589e\u52a0\uff0c\u53ec\u56de\u7387\u964d\u4f4e\u3002\u53cd\u4e4b\u4ea6\u7136\u3002\u5982\u679c\u6b63\u7c7b\u5f97\u5206\u5206\u5e03\u548c\u8d1f\u7c7b\u5f97\u5206\u5206\u5e03\u662f\u7edd\u5bf9\u53ef\u5206\u7684\uff0c\u90a3\u4e48\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u5c31\u4e0d\u5b58\u5728\u8fd9\u79cd\u6b64\u6d88\u5f7c\u957f\u7684\u5173\u7cfb</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#f1-score","title":"F1 Score","text":"<p>F1 Score\u662f\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u7684\u8c03\u548c\u5e73\u5747\u6570 $$ F1 \\ Score = 2 \u00b7 \\frac{Precision\u00b7Recall}{Precision + Recall} $$</p> <p>\u8c03\u548c\u5e73\u5747\u6570\uff1a\u5012\u6570\u7684\u7b97\u672f\u5e73\u5747\u6570\u7684\u5012\u6570</p> <p>\u5bf9\u4e8e\u975e\u8d1f\u7684 $a,b$\uff0c\u5b83\u4eec\u7684\u8c03\u548c\u5e73\u5747\u6570\u4e3a\uff1a $$ \\frac{1}{c} = \\frac{\\frac{1}{a}+\\frac{1}{b}}{2} =&gt;c = 2\u00b7\\frac{ab}{a+b} $$ \u8c03\u548c\u5e73\u5747\u6570\u662f\u5bf9\u8f83\u5c0f\u7684\u6570\u503c\u66f4\u654f\u611f\uff0c\u82e5\u67d0\u4e2a\u503c\u63a5\u8fd10\uff0c\u8c03\u548c\u5e73\u5747\u6570\u4f1a\u663e\u8457\u964d\u4f4e\u3002\u8c03\u548c\u5e73\u5747\u6570\u5f3a\u8c03\u6570\u636e\u7684\u5e73\u8861\u6027\uff0c\u82e5\u6570\u636e\u4e0d\u5e73\u8861\uff0c\u8c03\u548c\u5e73\u5747\u6570\u4f1a\u504f\u5411\u8f83\u5c0f\u7684\u503c</p> <p>F1 Score\u4e4b\u6240\u4ee5\u9009\u62e9\u8c03\u548c\u5e73\u5747\u6570\u6765\u4f5c\u4e3a\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u7684\u6743\u8861\uff0c\u4e3b\u8981\u662f\u56e0\u4e3a\u8c03\u548c\u5e73\u5747\u6570\u4f1a\u201c\u60e9\u7f5a\u201d\u4e0d\u5e73\u8861\u7684\u6570\u636e\uff0c\u8fd9\u79cd\u60e9\u7f5a\u4f5c\u7528\u786e\u4fdd\u4e86F1\u5206\u6570\u53ea\u6709\u5728\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u90fd\u8f83\u9ad8\u65f6\u624d\u9ad8</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#pr-curve","title":"PR Curve","text":"<p>PR\u66f2\u7ebf\u662f\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u4e4b\u95f4\u7684\u5173\u7cfb\u56fe\uff0c\u901a\u8fc7\u6539\u53d8\u5206\u7c7b\u6a21\u578b\u7684\u9884\u6d4b\u9608\u503c\uff0c\u8ba1\u7b97\u6bcf\u4e2a\u9608\u503c\u4e0b\u7684\u7684Precision\u548cRecall\u7136\u540e\u7ed8\u5236\u800c\u6210\u3002\u6a2a\u8f74\u662fRecall\uff0c\u7eb5\u8f74\u662fPrecision</p> <p>PR\u66f2\u7ebf\u7528\u4e8e\u53ef\u89c6\u5316\u7cbe\u5ea6\u548c\u53ec\u56de\u7387\u4e4b\u95f4\u7684\u6743\u8861\uff0c\u5e2e\u52a9\u9009\u62e9\u7279\u5b9a\u4efb\u52a1\u7684\u6700\u4f73\u9608\u503c</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#auc","title":"AUC","text":"<p>Area of Curve\uff0c\u67d0\u6761\u66f2\u7ebf\u4e0b\u7684\u9762\u79ef\u3002\u5177\u4f53\u542b\u4e49\u53d6\u51b3\u4e8e\u66f2\u7ebf\u7684\u7c7b\u578b\uff0c\u6700\u5e38\u89c1\u7684\u4e24\u79cdAUC\u662f\uff1aROC-AUC\u548cPR-AUC</p>"},{"location":"Dive2AI/5%20Metrics/Metrics/#multi-class-classification","title":"Multi-Class Classification","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#multi-label-classification","title":"Multi-Label Classification","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#regression","title":"Regression","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#object-detection","title":"Object Detection","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#image-segmentation","title":"Image Segmentation","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#natural-language-processnlp","title":"Natural Language Process(NLP)","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#generative-tasks","title":"Generative Tasks","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#recommendation-systems","title":"Recommendation Systems","text":""},{"location":"Dive2AI/5%20Metrics/Metrics/#time-series-forecasting","title":"Time Series Forecasting","text":""},{"location":"Dive2AI/6%20Inference/Onnx%20Runtime/","title":"\u4ecb\u7ecd","text":"<p>\u5b98\u65b9\u6587\u6863\uff1a</p> <p>ONNX Runtime | onnxruntime</p> <p>ONNX Runtime \u662f\u4e00\u4e2a\u5f00\u6e90\u7684\u3001\u9ad8\u6027\u80fd\u7684\u63a8\u7406\u5f15\u64ce\uff0c\u65e8\u5728\u52a0\u901f\u673a\u5668\u5b66\u4e60\u6a21\u578b\u7684\u90e8\u7f72\u548c\u8fd0\u884c\u3002\u5b83\u7531\u5fae\u8f6f\u53d1\u8d77\u5e76\u4e0e\u591a\u4e2a\u5408\u4f5c\u4f19\u4f34\u5171\u540c\u5f00\u53d1\uff0c\u652f\u6301 ONNX\uff08Open Neural Network Exchange\uff09\u683c\u5f0f\u7684\u6a21\u578b\u3002ONNX \u662f\u4e00\u79cd\u901a\u7528\u7684\u6a21\u578b\u4ea4\u6362\u683c\u5f0f\uff0c\u53ef\u4ee5\u8ba9\u5f00\u53d1\u8005\u5728\u4e0d\u540c\u6846\u67b6\uff08\u5982 PyTorch\u3001TensorFlow \u7b49\uff09\u4e4b\u95f4\u65e0\u7f1d\u8fc1\u79fb\u6a21\u578b\uff0c\u5e76\u5c06\u5176\u90e8\u7f72\u5230\u5404\u79cd\u786c\u4ef6\u5e73\u53f0\u4e0a\u3002</p>"},{"location":"Dive2AI/6%20Inference/Onnx%20Runtime/#_2","title":"\u4e3b\u8981\u7279\u70b9","text":"<ol> <li>\u8de8\u5e73\u53f0\u652f\u6301\uff1aONNX Runtime \u53ef\u4ee5\u5728\u591a\u79cd\u64cd\u4f5c\u7cfb\u7edf\uff08\u5982 Windows\u3001Linux\u3001macOS\uff09\u548c\u786c\u4ef6\uff08\u5982 CPU\u3001GPU\u3001TPU \u7b49\uff09\u4e0a\u8fd0\u884c\uff0c\u652f\u6301\u5305\u62ec NVIDIA CUDA\u3001Intel oneDNN\u3001AMD ROCm \u7b49\u52a0\u901f\u5e93\u3002</li> <li>\u9ad8\u6027\u80fd\u4f18\u5316\uff1a\u5b83\u901a\u8fc7\u56fe\u4f18\u5316\u3001\u7b97\u5b50\u878d\u5408\u548c\u786c\u4ef6\u52a0\u901f\u7b49\u6280\u672f\uff0c\u663e\u8457\u63d0\u5347\u6a21\u578b\u63a8\u7406\u7684\u901f\u5ea6\u548c\u6548\u7387\u3002</li> <li>\u5e7f\u6cdb\u7684\u751f\u6001\u517c\u5bb9\u6027\uff1a\u652f\u6301\u591a\u79cd\u673a\u5668\u5b66\u4e60\u6846\u67b6\u5bfc\u51fa\u7684 ONNX \u6a21\u578b\uff0c\u540c\u65f6\u63d0\u4f9b Python\u3001C++\u3001C# \u7b49\u591a\u79cd\u8bed\u8a00\u7684 API\uff0c\u65b9\u4fbf\u5f00\u53d1\u8005\u96c6\u6210\u3002</li> <li>\u6269\u5c55\u6027\uff1a\u652f\u6301\u81ea\u5b9a\u4e49\u7b97\u5b50\uff0c\u5141\u8bb8\u5f00\u53d1\u8005\u6839\u636e\u9700\u6c42\u6269\u5c55\u529f\u80fd\uff0c\u9002\u7528\u4e8e\u7279\u5b9a\u573a\u666f\u3002</li> <li>\u90e8\u7f72\u7075\u6d3b\u6027\uff1a\u53ef\u7528\u4e8e\u4e91\u7aef\u3001\u8fb9\u7f18\u8bbe\u5907\u751a\u81f3\u79fb\u52a8\u8bbe\u5907\uff0c\u5e7f\u6cdb\u5e94\u7528\u4e8e IoT\u3001\u5d4c\u5165\u5f0f\u7cfb\u7edf\u7b49\u9886\u57df\u3002</li> </ol>"},{"location":"Dive2AI/6%20Inference/Onnx%20Runtime/#_3","title":"\u5e94\u7528\u573a\u666f","text":"<ul> <li>\u6a21\u578b\u63a8\u7406\uff1a\u5c06\u8bad\u7ec3\u597d\u7684\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u5feb\u901f\u90e8\u7f72\u5230\u751f\u4ea7\u73af\u5883\u4e2d\u3002</li> <li>\u8de8\u6846\u67b6\u8fc1\u79fb\uff1a\u5728\u4e0d\u540c\u6846\u67b6\u95f4\u8f6c\u6362\u6a21\u578b\u65f6\u4fdd\u6301\u4e00\u81f4\u6027\u548c\u6027\u80fd\u3002</li> <li>\u786c\u4ef6\u52a0\u901f\uff1a\u5145\u5206\u5229\u7528 GPU \u6216\u4e13\u7528 AI \u82af\u7247\uff08\u5982 NVIDIA TensorRT\u3001Arm NN\uff09\u63d0\u5347\u63a8\u7406\u901f\u5ea6\u3002</li> </ul>"},{"location":"Dive2AI/6%20Inference/Onnx%20Runtime/#_4","title":"\u4f7f\u7528","text":""}]}